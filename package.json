{
  "name": "hearthcast-tv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HearthCast TV: Interactive 10-Foot Family Trivia & Story Night for Amazon Fire TV and Vega OS",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5180 --strictPort",
    "test": "node --experimental-strip-types src/test/hearthcast-verification.test.ts",
    "check": "tsc --noEmit && npm test"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
