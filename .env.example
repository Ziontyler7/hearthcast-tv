# HearthCast TV — Amazon Fire TV & Vega OS Configuration (Port 5180)
# Works 100% offline/locally in deterministic_local mode with zero API keys required.

VITE_HOST=127.0.0.1
VITE_PORT=5180
VITE_STRICT_PORT=true
VITE_DEFAULT_MODE=deterministic_local

# Optional AWS Builder Mini Challenge (Amazon Bedrock Converse API — Nova Pro)
AWS_REGION=us-east-1
VITE_BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
